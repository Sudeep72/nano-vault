# Application
APP_NAME=NanoVault
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-secret-key-min-32-chars
API_V1_PREFIX=/api/v1

# JWT
JWT_SECRET_KEY=change-me-to-another-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://nano_vault_user:nano_vault_pass@db:5432/nano_vault_db

# Encryption
ENCRYPTION_KEY=change-me-to-32-byte-base64-encoded-key==

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
